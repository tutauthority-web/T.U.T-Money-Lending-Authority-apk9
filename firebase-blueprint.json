{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and financial summary",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "nid": { "type": "string" },
        "address": { "type": "string" },
        "occupation": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "memberId": { "type": "string" },
        "totalLoan": { "type": "number" },
        "totalDeposit": { "type": "number" },
        "remainingDebt": { "type": "number" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "phone", "status", "role"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial request or external payment (Loan, Deposit, Refund, Pay Due, Subscription, Merchant Payment)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["loan", "deposit", "refund", "pay_due", "subscription", "merchant_payment", "card_payment", "wallet_payment"] },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["Cash", "Bkash", "Nagad", "Recharge", "Account Balance", "T.U.T. Card", "T.U.T. Wallet"] },
        "accountNumber": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "rejected", "settled"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "memoId": { "type": "string" },
        "adminNotes": { "type": "string" },
        "decidedBy": { "type": "string" },
        "decidedAt": { "type": "string" },
        "moreInfoRequested": { "type": "boolean" },
        "merchantId": { "type": "string" },
        "merchantName": { "type": "string" },
        "orderId": { "type": "string" },
        "paymentInstrument": { "type": "string", "enum": ["tut_card", "tut_wallet", "tut_credit"] },
        "fundingSource": { "type": "string", "enum": ["wallet_deposit", "credit_line"] },
        "cardLast4": { "type": "string" }
      },
      "required": ["userId", "type", "amount", "method", "status", "timestamp"]
    },
    "Sponsorship": {
      "title": "Sponsorship",
      "description": "Corporate sponsorship deal",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "dealValue": { "type": "number" },
        "campaignType": { "type": "string", "enum": ["Premium Partner", "Strategic Collab", "Community Sponsor"] },
        "promotionText": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "paused", "completed"] },
        "impressions": { "type": "number" },
        "clicks": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "logoUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "targetUrl": { "type": "string" },
        "specialOffer": { "type": "string" },
        "placement": { "type": "string", "enum": ["all", "entrance_popup", "deals_hero", "featured_carousel", "partner_grid"] },
        "targetAudience": { "type": "string", "enum": ["all", "standard", "bronze", "silver", "gold", "active_borrowers", "depositors"] },
        "priority": { "type": "number" },
        "isPinned": { "type": "boolean" },
        "category": { "type": "string", "enum": ["Fintech", "Shopping", "Food", "Mobility", "Telecom", "General"] },
        "discountBadge": { "type": "string" },
        "ctaLabel": { "type": "string" },
        "accentColor": { "type": "string" },
        "maxImpressions": { "type": "number" },
        "frequencyCapHours": { "type": "number" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["companyName", "dealValue", "campaignType", "promotionText", "status", "impressions", "startDate", "endDate"]
    },
    "SystemControls": {
      "title": "SystemControls",
      "description": "System parameters and authority controls",
      "type": "object",
      "properties": {
        "personalFund": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System action audit log entry",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "actorEmail": { "type": "string" },
        "actorName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] }
      },
      "required": ["timestamp", "actorEmail", "actorName", "action", "details", "severity"]
    },
    "EmailLog": {
      "title": "EmailLog",
      "description": "Log of dispatched email notification",
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "recipientName": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "status": { "type": "string", "enum": ["delivered", "failed"] },
        "error": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "category": { "type": "string" }
      },
      "required": ["to", "recipientName", "subject", "body", "status", "timestamp", "category"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "User linked digital wallet (bKash/Nagad)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "provider": { "type": "string", "enum": ["bKash", "Nagad"] },
        "holderName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "isDefault": { "type": "boolean" },
        "dateLinked": { "type": "string", "format": "date-time" }
      },
      "required": ["provider", "holderName", "mobileNumber", "isVerified", "isDefault", "dateLinked"]
    },
    "Card": {
      "title": "Card",
      "description": "User added credit/debit card for Beta Waitlist",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cardType": { "type": "string", "enum": ["Visa", "Mastercard"] },
        "holderName": { "type": "string" },
        "cardNumber": { "type": "string" },
        "expiryDate": { "type": "string" },
        "dateAdded": { "type": "string", "format": "date-time" }
      },
      "required": ["cardType", "holderName", "cardNumber", "expiryDate", "dateAdded"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Stationed digital or human workforce support officer",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "photoUrl": { "type": "string" },
        "department": { "type": "string" },
        "position": { "type": "string" },
        "joinedDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Available", "Busy", "Offline"] },
        "performanceScore": { "type": "number" },
        "employeeType": { "type": "string", "enum": ["Digital Employee", "Human Employee"] },
        "internalAiCode": { "type": "string" },
        "aiModelVersion": { "type": "string" },
        "knowledgeVersion": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "averageResponseTime": { "type": "string" },
        "customerSatisfaction": { "type": "string" },
        "totalChats": { "type": "number" }
      },
      "required": ["name", "photoUrl", "department", "position", "joinedDate", "status", "performanceScore", "employeeType"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Escalated support and compliance ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High", "Urgent"] },
        "category": { "type": "string", "enum": ["Loan Issue", "Deposit Help", "Security Block", "General Help", "Technical Error"] },
        "assignedDepartment": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved"] },
        "description": { "type": "string" },
        "estimatedResponseTime": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "userEmail", "userName", "priority", "category", "assignedDepartment", "status", "description", "estimatedResponseTime", "createdAt", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Corporate workforce chat session between a user and employee",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "messages": { "type": "array" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "escalated"] }
      },
      "required": ["userId", "userName", "employeeId", "employeeName", "messages", "lastMessage", "updatedAt", "status"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Firestore connection validation document",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    },
    "AgentReportedIssue": {
      "title": "AgentReportedIssue",
      "description": "Member issue noted down by AI banking agents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "agentId": { "type": "string" },
        "agentName": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "status": { "type": "string", "enum": ["Pending Review", "Investigating", "Resolved"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "agentId", "agentName", "memberId", "memberName", "category", "summary", "priority", "status", "timestamp"]
    },
    "WorkforceP2PChat": {
      "title": "WorkforceP2PChat",
      "description": "Direct chat between administrator and AI banking agents",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "employeeId": { "type": "string" },
        "messages": { "type": "array" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["employeeId", "messages", "lastMessage", "updatedAt"]
    },
    "TutPayCard": {
      "title": "TutPayCard",
      "description": "Payable T.U.T. virtual card credential (stores salted PBKDF2/SHA-256 key & recovery digests, never plaintext secrets)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "memberId": { "type": "string" },
        "cardNumber": { "type": "string" },
        "cardLast4": { "type": "string" },
        "cardHash": { "type": "string" },
        "expiryMonth": { "type": "string" },
        "expiryYear": { "type": "string" },
        "secretCodeHash": { "type": "string" },
        "secretCodeSalt": { "type": "string" },
        "recoveryKeyHash": { "type": "string" },
        "recoveryKeySalt": { "type": "string" },
        "securityQuestion": { "type": "string" },
        "securityAnswerHash": { "type": "string" },
        "securityAnswerSalt": { "type": "string" },
        "recoveryCount": { "type": "number" },
        "lastRecoveryMethod": { "type": "string", "enum": ["email_otp", "backup_key", "security_question", "admin_unlock"] },
        "lastRecoveryAt": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isFrozen": { "type": "boolean" },
        "perTxLimit": { "type": "number" },
        "dailyLimit": { "type": "number" },
        "failedAttempts": { "type": "number" },
        "lockedUntil": { "type": "number" },
        "pinSetAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "cardNumber", "cardLast4", "cardHash", "expiryMonth", "expiryYear", "secretCodeHash", "secretCodeSalt", "isActive", "isFrozen", "perTxLimit", "failedAttempts"]
    },
    "MerchantApp": {
      "title": "MerchantApp",
      "description": "Registered partner application metadata for T.U.T. Card-Only Gateway v2",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "name": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "apiKeyId": { "type": "string" },
        "allowedOrigins": { "type": "array" },
        "webhookUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "paused"] },
        "totalProcessed": { "type": "number" },
        "txCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["merchantId", "name", "apiKeyId", "status"]
    },
    "MerchantSecret": {
      "title": "MerchantSecret",
      "description": "Admin-only cryptographic API key hashes for registered partner apps",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string" },
        "apiKeyId": { "type": "string" },
        "apiKeyHash": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["merchantId", "apiKeyId", "apiKeyHash"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/wallets/{walletId}": {
      "schema": "Wallet",
      "description": "User linked wallets"
    },
    "/users/{userId}/cards/{cardId}": {
      "schema": "Card",
      "description": "User added credit/debit cards"
    },
    "/tut_cards/{userId}": {
      "schema": "TutPayCard",
      "description": "Payable T.U.T. Authority virtual payment card credentials and recovery controls"
    },
    "/merchant_apps/{merchantId}": {
      "schema": "MerchantApp",
      "description": "Connected partner applications accepted by T.U.T. Card Payment Gateway"
    },
    "/merchant_secrets/{merchantId}": {
      "schema": "MerchantSecret",
      "description": "Admin-only API key hashes for registered merchant apps"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions"
    },
    "/sponsorships/{sponsorshipId}": {
      "schema": "Sponsorship",
      "description": "Corporate sponsorship campaigns"
    },
    "/system_controls/{documentId}": {
      "schema": "SystemControls",
      "description": "Authority settings and capital control parameters"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Regulatory audit log records"
    },
    "/email_logs/{logId}": {
      "schema": "EmailLog",
      "description": "Email dispatch history logs"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Staff and AI employees directory"
    },
    "/workforce_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Escalated customer support tickets"
    },
    "/agent_reported_issues/{issueId}": {
      "schema": "AgentReportedIssue",
      "description": "Member issues logged by AI agents"
    },
    "/workforce_chats/{chatId}": {
      "schema": "ChatSession",
      "description": "Chat sessions with staff or digital officers"
    },
    "/workforce_p2p_chats/{chatId}": {
      "schema": "WorkforceP2PChat",
      "description": "Direct communication between admin and AI banking agents"
    },
    "/test/{docId}": {
      "schema": "TestConnection",
      "description": "Firestore connection validation endpoint"
    }
  }
}
