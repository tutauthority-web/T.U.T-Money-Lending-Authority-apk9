rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields:
    //   - uid: string (required)
    //   - name: string (required)
    //   - nid: string
    //   - address: string
    //   - occupation: string
    //   - phone: string (required)
    //   - status: string (pending, approved)
    //   - memberId: string
    //   - totalLoan: number
    //   - totalDeposit: number
    //   - remainingDebt: number
    //   - role: string (admin, member)
    //
    // Collection: transactions
    // Fields:
    //   - userId: string (required)
    //   - type: string (loan, deposit)
    //   - amount: number (required)
    //   - status: string (pending, confirmed)
    //   - timestamp: timestamp (required)
    //   - memoId: string
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          request.auth.uid == "qLF3AOrlPaX4Jv43zy2uOOKeq952" ||
          (request.auth.token.email != null && 
           request.auth.token.email_verified == true &&
            (request.auth.token.email == "tahsinullahtusher999@gmail.com" || 
             request.auth.token.email.lower() == "tahsinullahtusher999@gmail.com" ||
             request.auth.token.email.lower() == "tahsinullahtusher@gmail.com" ||
             request.auth.token.email.lower() == "admin@tut.org")
          ) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin', 'authority']) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name in [
             'Tusnut Jahan', 
             'Adnan Chowdhury', 
             'Sajib Rahman', 
             'Farhana Yasmin', 
             'Tahsin Ullah Tusher'
           ])
        );
    }

    function isStaffMember() {
      return isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name in [
            'Tusnut Jahan', 
            'Adnan Chowdhury', 
            'Sajib Rahman', 
            'Farhana Yasmin', 
            'Tahsin Ullah Tusher'
          ]
        )
      );
    }

    function isNumeric(val) {
      return val is int || val is float;
    }

    function isValidUser(data) {
      return (!('name' in data) || (data.name is string && data.name.size() < 100)) &&
             (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('status' in data) || (data.status is string && data.status in ['pending', 'approved', 'rejected', 'active', 'suspended', 'info_requested', 'verification_pending'])) &&
             (!('role' in data) || (data.role is string && data.role in ['admin', 'member', 'moderator', 'staff'])) &&
             (!('nid' in data) || (data.nid is string && data.nid.size() <= 50)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             (!('permanentAddress' in data) || (data.permanentAddress is string && data.permanentAddress.size() <= 500)) &&
             (!('occupation' in data) || (data.occupation is string && data.occupation.size() <= 200)) &&
             (!('memberId' in data) || (data.memberId is string && data.memberId.size() <= 50)) &&
             (!('totalLoan' in data) || isNumeric(data.totalLoan)) &&
             (!('totalDeposit' in data) || isNumeric(data.totalDeposit)) &&
             (!('remainingDebt' in data) || isNumeric(data.remainingDebt)) &&
             (!('totalRepaid' in data) || isNumeric(data.totalRepaid)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is string || isNumeric(data.createdAt))) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt is string || isNumeric(data.updatedAt))) &&
             (!('approvedAt' in data) || (data.approvedAt is string || data.approvedAt is timestamp || isNumeric(data.approvedAt))) &&
             (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 5000)) &&
             (!('assignedModerator' in data) || (data.assignedModerator is string && data.assignedModerator.size() <= 200)) &&
             (!('emailNotificationsEnabled' in data) || data.emailNotificationsEnabled is bool) &&
             (!('email' in data) || (data.email is string && data.email.size() < 100)) &&
             (!('facebook' in data) || data.facebook is string) &&
             (!('whatsapp' in data) || data.whatsapp is string) &&
             (!('telegram' in data) || data.telegram is string) &&
             (!('fatherName' in data) || data.fatherName is string) &&
             (!('motherName' in data) || data.motherName is string) &&
             (!('dob' in data) || data.dob is string) &&
             (!('bloodGroup' in data) || data.bloodGroup is string) &&
             (!('emergencyContact' in data) || data.emergencyContact is string) &&
             (!('nomineeName' in data) || data.nomineeName is string) &&
             (!('nomineeRelation' in data) || data.nomineeRelation is string) &&
             (!('subscriptionStatus' in data) || (data.subscriptionStatus is string) || data.subscriptionStatus == null) &&
             (!('subscriptionTier' in data) || (data.subscriptionTier is string) || data.subscriptionTier == null) &&
             (!('subscriptionExpiresAt' in data) || (data.subscriptionExpiresAt is string) || data.subscriptionExpiresAt == null) &&
             (!('continuousSubscriptionMonths' in data) || isNumeric(data.continuousSubscriptionMonths)) &&
             (!('consecutiveNoLoanMonths' in data) || isNumeric(data.consecutiveNoLoanMonths)) &&
             (!('loansTakenThisMonth' in data) || isNumeric(data.loansTakenThisMonth)) &&
             (!('autoRenewSubscription' in data) || data.autoRenewSubscription is bool) &&
             (!('lastSubscriptionPaidAt' in data) || (data.lastSubscriptionPaidAt is timestamp || data.lastSubscriptionPaidAt is string || isNumeric(data.lastSubscriptionPaidAt))) &&
             (!('borrowingLimit' in data) || isNumeric(data.borrowingLimit));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'status', 'timestamp']) &&
             data.userId is string &&
             data.type is string &&
             isNumeric(data.amount) && data.amount >= 0 && data.amount < 100000000 &&
             (!('method' in data) || (data.method is string && data.method.size() <= 60)) &&
             data.status is string &&
             (!('isPaid' in data) || data.isPaid is bool) &&
             (!('settledAt' in data) || (data.settledAt is string || data.settledAt is timestamp || isNumeric(data.settledAt))) &&
             (!('settledBy' in data) || (data.settledBy is string && data.settledBy.size() <= 200)) &&
             (!('accountNumber' in data) || (data.accountNumber is string && data.accountNumber.size() < 50)) &&
             (!('transactionId' in data) || (data.transactionId is string && data.transactionId.size() < 100)) &&
             (!('userName' in data) || (data.userName is string && data.userName.size() < 100)) &&
             (!('memoId' in data) || (data.memoId is string && data.memoId.size() < 50)) &&
             (!('loanReason' in data) || (data.loanReason is string)) &&
             (!('purpose' in data) || (data.purpose is string)) &&
             (!('estimatedRepaymentDate' in data) || (data.estimatedRepaymentDate is string)) &&
             (!('lastReminderSent' in data) || (isNumeric(data.lastReminderSent) || data.lastReminderSent is string)) &&
             (!('subscriptionTier' in data) || (data.subscriptionTier is string)) &&
             (!('subscriptionMonths' in data) || isNumeric(data.subscriptionMonths)) &&
             (!('isTransfer' in data) || data.isTransfer is bool) &&
             (!('transferType' in data) || (data.transferType is string && data.transferType in ['in', 'out'])) &&
             (!('transferRecipientName' in data) || (data.transferRecipientName is string && data.transferRecipientName.size() < 100)) &&
             (!('transferRecipientId' in data) || (data.transferRecipientId is string && data.transferRecipientId.size() < 100)) &&
             (!('transferSenderName' in data) || (data.transferSenderName is string && data.transferSenderName.size() < 100)) &&
             (!('transferSenderId' in data) || (data.transferSenderId is string && data.transferSenderId.size() < 100)) &&
             (!('reference' in data) || (data.reference is string && data.reference.size() <= 200)) &&
             (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 5000)) &&
             (!('decidedBy' in data) || (data.decidedBy is string && data.decidedBy.size() <= 200)) &&
             (!('decidedAt' in data) || (data.decidedAt is string && data.decidedAt.size() <= 100)) &&
             (!('moreInfoRequested' in data) || data.moreInfoRequested is bool) &&
             (!('assignedModerator' in data) || (data.assignedModerator is string && data.assignedModerator.size() <= 200)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt is string || isNumeric(data.updatedAt))) &&
             (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is string || isNumeric(data.createdAt))) &&
             (!('paidAmount' in data) || isNumeric(data.paidAmount)) &&
             (!('remainingBalance' in data) || isNumeric(data.remainingBalance)) &&
             (!('exactAmount' in data) || isNumeric(data.exactAmount)) &&
             (!('receiptReserved' in data) || data.receiptReserved is bool) &&
             (!('dueDate' in data) || (data.dueDate is string || data.dueDate is timestamp)) &&
             (!('approvedAt' in data) || (data.approvedAt is timestamp || data.approvedAt is string || isNumeric(data.approvedAt))) &&
             (!('allocationStatus' in data) || (data.allocationStatus is string && data.allocationStatus.size() <= 50)) &&
             (!('merchantId' in data) || (data.merchantId is string && data.merchantId.size() <= 100)) &&
             (!('merchantName' in data) || (data.merchantName is string && data.merchantName.size() <= 150)) &&
             (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 120)) &&
             (!('paymentInstrument' in data) || (data.paymentInstrument is string && data.paymentInstrument in ['tut_card', 'tut_wallet', 'tut_credit'])) &&
             (!('fundingSource' in data) || (data.fundingSource is string && data.fundingSource in ['wallet_deposit', 'credit_line'])) &&
             (!('cardLast4' in data) || (data.cardLast4 is string && data.cardLast4.size() <= 8));
    }

    function isValidSponsorship(data) {
      return data.keys().hasAll(['companyName', 'dealValue', 'campaignType', 'promotionText', 'status', 'impressions', 'startDate', 'endDate']) &&
             data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 200 &&
             isNumeric(data.dealValue) && data.dealValue >= 0 &&
             data.campaignType in ['Premium Partner', 'Strategic Collab', 'Community Sponsor'] &&
             data.promotionText is string && data.promotionText.size() > 0 && data.promotionText.size() <= 1000 &&
             data.status in ['active', 'paused', 'completed'] &&
             isNumeric(data.impressions) && data.impressions >= 0 &&
             data.startDate is string &&
             data.endDate is string &&
             (!('clicks' in data) || isNumeric(data.clicks)) &&
             (!('logoUrl' in data) || data.logoUrl is string) &&
             (!('imageUrl' in data) || data.imageUrl is string) &&
             (!('videoUrl' in data) || data.videoUrl is string) &&
             (!('targetUrl' in data) || data.targetUrl is string) &&
             (!('specialOffer' in data) || data.specialOffer is string) &&
             (!('placement' in data) || (data.placement is string && data.placement in ['all', 'entrance_popup', 'deals_hero', 'featured_carousel', 'partner_grid'])) &&
             (!('targetAudience' in data) || (data.targetAudience is string && data.targetAudience in ['all', 'standard', 'bronze', 'silver', 'gold', 'active_borrowers', 'depositors'])) &&
             (!('priority' in data) || (isNumeric(data.priority) && data.priority >= 1 && data.priority <= 10)) &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('category' in data) || (data.category is string && data.category in ['Fintech', 'Shopping', 'Food', 'Mobility', 'Telecom', 'General'])) &&
             (!('discountBadge' in data) || (data.discountBadge is string && data.discountBadge.size() <= 40)) &&
             (!('ctaLabel' in data) || (data.ctaLabel is string && data.ctaLabel.size() <= 40)) &&
             (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 20)) &&
             (!('maxImpressions' in data) || (isNumeric(data.maxImpressions) && data.maxImpressions >= 0)) &&
             (!('frequencyCapHours' in data) || (isNumeric(data.frequencyCapHours) && data.frequencyCapHours >= 0)) &&
             (!('updatedAt' in data) || (data.updatedAt is string || data.updatedAt is timestamp || isNumeric(data.updatedAt))) &&
             (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 200));
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['timestamp', 'actorEmail', 'actorName', 'action', 'details', 'severity']) &&
             data.timestamp is timestamp &&
             data.actorEmail is string && data.actorEmail.size() > 0 &&
             data.actorName is string && data.actorName.size() > 0 &&
             data.action is string && data.action.size() > 0 &&
             data.details is string && data.details.size() > 0 &&
             data.severity in ['info', 'warning', 'critical'];
    }

    function isValidEmailLog(data) {
      return data.keys().hasAll(['to', 'recipientName', 'subject', 'body', 'status', 'timestamp', 'category']) &&
             data.to is string && data.to.size() > 0 &&
             data.recipientName is string &&
             data.subject is string && data.subject.size() > 0 &&
             data.body is string && data.body.size() > 0 &&
             data.status in ['delivered', 'failed'] &&
             data.timestamp is timestamp &&
             data.category is string &&
             (!('error' in data) || data.error is string);
    }

    function isValidWallet(data) {
      return data.keys().hasAll(['provider', 'holderName', 'mobileNumber', 'isVerified', 'isDefault', 'dateLinked']) &&
             data.provider in ['bKash', 'Nagad'] &&
             data.holderName is string && data.holderName.size() > 0 && data.holderName.size() < 100 &&
             data.mobileNumber is string && data.mobileNumber.size() >= 11 && data.mobileNumber.size() <= 15 &&
             data.isVerified is bool &&
             data.isDefault is bool &&
             data.dateLinked is timestamp;
    }

    function isValidCard(data) {
      return data.keys().hasAll(['cardType', 'holderName', 'cardNumber', 'expiryDate', 'dateAdded']) &&
             data.cardType in ['Visa', 'Mastercard'] &&
             data.holderName is string && data.holderName.size() > 0 && data.holderName.size() < 100 &&
             data.cardNumber is string && data.cardNumber.size() >= 12 && data.cardNumber.size() <= 25 &&
             data.expiryDate is string && data.expiryDate.size() == 5 &&
             data.dateAdded is timestamp;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'photoUrl', 'department', 'position', 'joinedDate', 'status', 'performanceScore', 'employeeType']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.photoUrl is string && data.photoUrl.size() <= 1048576 &&
             data.department is string &&
             data.position is string &&
             data.joinedDate is string &&
             data.status in ['Available', 'Busy', 'Offline'] &&
             isNumeric(data.performanceScore) &&
             data.employeeType in ['Digital Employee', 'Human Employee'] &&
             (!('internalAiCode' in data) || data.internalAiCode is string) &&
             (!('aiModelVersion' in data) || data.aiModelVersion is string) &&
             (!('knowledgeVersion' in data) || data.knowledgeVersion is string) &&
             (!('lastUpdated' in data) || data.lastUpdated is string) &&
             (!('averageResponseTime' in data) || data.averageResponseTime is string) &&
             (!('customerSatisfaction' in data) || data.customerSatisfaction is string) &&
             (!('totalChats' in data) || isNumeric(data.totalChats));
    }

    function isValidWorkforceTicket(data) {
      return data.keys().hasAll(['userId', 'userName', 'priority', 'category', 'status', 'description', 'createdAt', 'updatedAt']) &&
             data.userId is string &&
             data.userName is string &&
             data.priority in ['Low', 'Medium', 'High', 'Urgent'] &&
             data.category in ['Loan Issue', 'Deposit Help', 'Security Block', 'General Help', 'Technical Error'] &&
             data.status in ['Open', 'In Progress', 'Resolved'] &&
             data.description is string &&
             isNumeric(data.createdAt) &&
             isNumeric(data.updatedAt) &&
             (!('id' in data) || data.id is string) &&
             (!('userEmail' in data) || data.userEmail is string) &&
             (!('assignedDepartment' in data) || data.assignedDepartment is string) &&
             (!('estimatedResponseTime' in data) || data.estimatedResponseTime is string);
    }

    function isValidWorkforceChat(data) {
      return data.keys().hasAll(['userId', 'userName', 'employeeId', 'employeeName', 'messages', 'lastMessage', 'updatedAt', 'status']) &&
             data.userId is string &&
             data.userName is string &&
             data.employeeId is string &&
             data.employeeName is string &&
             data.messages is list &&
             data.lastMessage is string &&
             isNumeric(data.updatedAt) &&
             data.status in ['active', 'escalated'];
    }

    function isValidTutCard(data) {
      return data.keys().hasAll(['userId', 'cardNumber', 'cardLast4', 'cardHash', 'expiryMonth', 'expiryYear', 'secretCodeHash', 'secretCodeSalt', 'isActive', 'isFrozen', 'perTxLimit', 'failedAttempts']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.cardNumber is string && data.cardNumber.size() == 16 &&
             data.cardLast4 is string && data.cardLast4.size() == 4 &&
             data.cardHash is string && data.cardHash.size() == 64 &&
             data.expiryMonth is string && data.expiryMonth.size() == 2 &&
             data.expiryYear is string && data.expiryYear.size() == 2 &&
             data.secretCodeHash is string && data.secretCodeHash.size() >= 64 && data.secretCodeHash.size() <= 128 &&
             data.secretCodeSalt is string && data.secretCodeSalt.size() >= 16 && data.secretCodeSalt.size() <= 64 &&
             (!('recoveryKeyHash' in data) || (data.recoveryKeyHash is string && data.recoveryKeyHash.size() >= 64 && data.recoveryKeyHash.size() <= 128)) &&
             (!('recoveryKeySalt' in data) || (data.recoveryKeySalt is string && data.recoveryKeySalt.size() >= 16 && data.recoveryKeySalt.size() <= 64)) &&
             (!('securityQuestion' in data) || (data.securityQuestion is string && data.securityQuestion.size() <= 160)) &&
             (!('securityAnswerHash' in data) || (data.securityAnswerHash is string && data.securityAnswerHash.size() >= 64 && data.securityAnswerHash.size() <= 128)) &&
             (!('securityAnswerSalt' in data) || (data.securityAnswerSalt is string && data.securityAnswerSalt.size() >= 16 && data.securityAnswerSalt.size() <= 64)) &&
             (!('recoveryCount' in data) || (isNumeric(data.recoveryCount) && data.recoveryCount >= 0 && data.recoveryCount <= 1000)) &&
             (!('lastRecoveryMethod' in data) || (data.lastRecoveryMethod is string && data.lastRecoveryMethod in ['email_otp', 'backup_key', 'security_question', 'admin_unlock'])) &&
             (!('lastRecoveryAt' in data) || (data.lastRecoveryAt is string && data.lastRecoveryAt.size() <= 64)) &&
             data.isActive is bool &&
             data.isFrozen is bool &&
             isNumeric(data.perTxLimit) && data.perTxLimit >= 10 && data.perTxLimit <= 500000 &&
             (!('dailyLimit' in data) || (isNumeric(data.dailyLimit) && data.dailyLimit >= 10 && data.dailyLimit <= 2000000)) &&
             isNumeric(data.failedAttempts) && data.failedAttempts >= 0 && data.failedAttempts <= 20 &&
             (!('lockedUntil' in data) || (isNumeric(data.lockedUntil) && data.lockedUntil >= 0)) &&
             (!('memberId' in data) || (data.memberId is string && data.memberId.size() <= 64)) &&
             (!('pinSetAt' in data) || (data.pinSetAt is string && data.pinSetAt.size() <= 64)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidMerchantApp(data) {
      return data.keys().hasAll(['merchantId', 'name', 'apiKeyId', 'status']) &&
             data.merchantId is string && data.merchantId.size() > 0 && data.merchantId.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.apiKeyId is string && data.apiKeyId.size() > 0 && data.apiKeyId.size() <= 64 &&
             data.status in ['active', 'paused'] &&
             (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 120)) &&
             (!('allowedOrigins' in data) || (data.allowedOrigins is list && data.allowedOrigins.size() <= 20)) &&
             (!('webhookUrl' in data) || (data.webhookUrl is string && data.webhookUrl.size() <= 300)) &&
             (!('totalProcessed' in data) || (isNumeric(data.totalProcessed) && data.totalProcessed >= 0)) &&
             (!('txCount' in data) || (isNumeric(data.txCount) && data.txCount >= 0)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidMerchantSecret(data) {
      return data.keys().hasAll(['merchantId', 'apiKeyId', 'apiKeyHash']) &&
             data.merchantId is string && data.merchantId.size() > 0 && data.merchantId.size() <= 100 &&
             data.apiKeyId is string && data.apiKeyId.size() > 0 && data.apiKeyId.size() <= 64 &&
             data.apiKeyHash is string && data.apiKeyHash.size() == 64 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /users/{userId} {
      allow get: if isAuthenticated() && (
        isOwner(userId) || 
        isAdmin() || 
        (resource != null && resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data) && 
                    ((!('role' in request.resource.data) || request.resource.data.role == 'member') || (request.resource.data.role == 'admin' && isAdmin()));
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (
        isAdmin() ||
        (isOwner(userId) && 
         (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) && 
         (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
        ) ||
        (
          // Allow updating own debt and repayment fields upon self loan settlement
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingDebt', 'totalRepaid', 'updatedAt'])
        ) ||
        (
          // Non-owner can only increment totalDeposit (as in P2P transfer credit)
          request.resource.data.totalDeposit > resource.data.totalDeposit &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalDeposit', 'updatedAt'])
        )
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())
      );

      match /wallets/{walletId} {
        allow read, list: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidWallet(request.resource.data);
        allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      match /cards/{cardId} {
        allow read, list: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidCard(request.resource.data);
        allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    match /transactions/{transactionId} {
      allow read, list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidTransaction(request.resource.data) && (
        isAdmin() ||
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status in ['pending', 'confirmed', 'approved'] &&
          (request.resource.data.type != 'merchant_payment' || (
            request.resource.data.paymentInstrument == 'tut_card' &&
            request.resource.data.status == 'confirmed'
          ))
        ) ||
        (request.resource.data.isTransfer == true && request.resource.data.transferType == 'in' && request.resource.data.status == 'confirmed')
      );
      allow update: if isAuthenticated() && isValidTransaction(request.resource.data) && (
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isPaid']) &&
          request.resource.data.status == 'settled' &&
          request.resource.data.isPaid == true
        )
      );
      allow delete: if isAdmin();
    }

    match /sponsorships/{sponsorshipId} {
      allow read, list: if true;
      allow create: if isAdmin() && isValidSponsorship(request.resource.data);
      allow update: if (isAdmin() && isValidSponsorship(request.resource.data)) ||
                       (isAuthenticated() && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions', 'clicks']));
      allow delete: if isAdmin() || (isAuthenticated() && sponsorshipId in ['sp-apex', 'sp-tusher', 'sp-bicon']);
    }

    match /system_controls/{documentId} {
      allow read, list: if true;
      allow create, update: if isAdmin() || (
        isAuthenticated() && (documentId == 'funds' || documentId == 'reserves' || documentId == 'sponsorships_seeded')
      );
      allow delete: if isAdmin();
    }

    match /subscription_funds/{docId} {
      allow read, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, list: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /email_logs/{logId} {
      allow read, list: if isAdmin();
      allow create: if isAdmin() && isValidEmailLog(request.resource.data);
      allow update, delete: if false;
    }

    match /employees/{employeeId} {
      allow read, list: if isAuthenticated();
      allow create: if isAdmin() || isStaffMember();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /workforce_tickets/{ticketId} {
      allow read, list, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /agent_reported_issues/{issueId} {
      allow read, list, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /workforce_chats/{chatId} {
      allow read, list, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    match /workforce_p2p_chats/{chatId} {
      allow read, list, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /tut_cards/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin()) &&
                    isValidTutCard(request.resource.data) &&
                    request.resource.data.userId == userId &&
                    request.resource.data.failedAttempts == 0 &&
                    (!('lockedUntil' in request.resource.data) || request.resource.data.lockedUntil == 0) &&
                    (!('recoveryCount' in request.resource.data) || request.resource.data.recoveryCount == 0);
      allow update: if isAuthenticated() &&
                    isValidTutCard(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId && (
        isAdmin() ||
        (
          // Action 1: Freeze toggle & per-transaction spend cap (cannot alter Payment Key or lock state)
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isFrozen', 'perTxLimit', 'dailyLimit', 'updatedAt'])
        ) ||
        (
          // Action 2: Failed attempt increment only (cannot lower failures or unlock)
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['failedAttempts', 'lockedUntil', 'updatedAt']) &&
          request.resource.data.failedAttempts == resource.data.failedAttempts + 1
        ) ||
        (
          // Action 3: Reset failed attempt counter after valid payment ONLY when not currently locked
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['failedAttempts', 'lockedUntil', 'updatedAt']) &&
          resource.data.failedAttempts > 0 &&
          request.resource.data.failedAttempts == 0 &&
          request.resource.data.lockedUntil == 0 &&
          (!('lockedUntil' in resource.data) || resource.data.lockedUntil == 0 || request.time.toMillis() >= resource.data.lockedUntil)
        ) ||
        (
          // Action 4: Smart Key Recovery (must increment recoveryCount & rotate recovery key)
          isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'secretCodeHash', 'secretCodeSalt', 'recoveryKeyHash', 'recoveryKeySalt',
            'recoveryCount', 'lastRecoveryMethod', 'lastRecoveryAt', 'pinSetAt',
            'failedAttempts', 'lockedUntil', 'updatedAt'
          ]) &&
          (
            ('recoveryCount' in resource.data && request.resource.data.recoveryCount == resource.data.recoveryCount + 1) ||
            (!('recoveryCount' in resource.data) && request.resource.data.recoveryCount == 1)
          ) &&
          request.resource.data.failedAttempts == 0 &&
          request.resource.data.lockedUntil == 0
        )
      );
      allow delete: if isAdmin();
    }

    match /merchant_apps/{merchantId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidMerchantApp(request.resource.data);
      allow update: if isAuthenticated() && isValidMerchantApp(request.resource.data) && (
        isAdmin() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalProcessed', 'txCount', 'updatedAt']) &&
          isNumeric(request.resource.data.totalProcessed) &&
          request.resource.data.totalProcessed > resource.data.totalProcessed
        )
      );
      allow delete: if isAdmin();
    }

    match /merchant_secrets/{merchantId} {
      allow read, list: if isAdmin();
      allow create, update: if isAdmin() && isValidMerchantSecret(request.resource.data);
      allow delete: if isAdmin();
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
