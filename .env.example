# ==============================================================================
# GEMINI AI API KEYS (MULTI-KEY & DEDICATED CHATBOT CREDITS CONFIGURATION)
# ==============================================================================
# Main Primary Key (automatically injected or provided in AI Studio Settings > Secrets):
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEDICATED KEYS FOR YOUR 2 CHATBOTS:
# Assign a dedicated API key for Chatbot 1: Zubair Ahmed (EMP-00101)
# Chats with Zubair will prioritize this key, preserving credits on your other accounts.
GEMINI_API_KEY_OFFICER_1=""

# Assign a dedicated API key for Chatbot 2: Nusrat Jahan (EMP-00102)
# Chats with Nusrat will prioritize this key, preserving credits on your other accounts.
GEMINI_API_KEY_OFFICER_2=""

# ADDITIONAL BACKUP / LOAD-BALANCING KEYS:
# Secondary and tertiary keys for automatic failover if any account runs out of credits:
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# Or specify a comma-separated list of keys:
# GEMINI_API_KEYS="key_alpha,key_beta,key_gamma"

# ==============================================================================
# APPLICATION & NOTIFICATIONS
# ==============================================================================
APP_URL="MY_APP_URL"
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=
